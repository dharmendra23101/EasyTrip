{
  "name": "easytrip-backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "lint": "eslint . --ext .js",
    "migrate": "node script/migrate.js",
    "migrate:status": "node script/migrate.js status",
    "migrate:dry-run": "node script/migrate.js --dry-run",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "node -e \"const pool=require('./src/config/db');require('./src/config/seed').reseed(pool).then(()=>{console.log('seeded');return pool.end()})\""
  },
  "keywords": [
    "easytrip",
    "travel",
    "express",
    "postgresql",
    "firebase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^7.0.0",
    "multer": "^2.2.0",
    "pg": "^8.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
