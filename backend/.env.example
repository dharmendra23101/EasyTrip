# EasyTrip — backend environment template
#
# Copy this file to backend/.env and replace every placeholder with a real value:
#     cp backend/.env.example backend/.env
#
# backend/.env is gitignored. Never commit real credentials, and never paste a
# real value back into this template.
#
# Vars marked REQUIRED must be set for the server to work. OPTIONAL vars have a
# working default in code.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# OPTIONAL — port Express listens on. Defaults to 5000 (app.js).
PORT=5000

# OPTIONAL — "development" or "production". Selects pg SSL and how much error
# detail responses expose. Only the literal "development" ever exposes driver
# error text; anything else (including unset) is treated as production-safe.
NODE_ENV=development

# REQUIRED IN PRODUCTION — comma-separated list of browser origins allowed to call
# this API. There is deliberately NO production fallback: an unset value would 403
# every browser request, so the server refuses to boot instead (app.js).
# In development it defaults to http://localhost:3000 when unset.
# NOTE: this replaces the older CORS_ORIGIN variable, which is no longer read.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://easytrip-psi.vercel.app

# OPTIONAL — logging verbosity: fatal | error | warn | info | debug | trace | silent.
# Defaults to "info" in production and "debug" in development; "silent" under test.
# Production output is newline-delimited JSON on stdout, which is what a container
# platform's log collector expects. Development pretty-prints it instead.
#
# Authorization headers, tokens, passwords and the secrets below are redacted from
# log output automatically (src/utils/logger.js), and user identifiers are not logged
# at all — requests are correlated by the x-request-id returned in the response.
# LOG_LEVEL=info

# OPTIONAL — number of reverse-proxy hops in front of the app. Rate limiting keys
# on the client IP, which arrives in X-Forwarded-For behind a proxy. Set to 1 on
# Render / Railway / Vercel / Fly and any load balancer. Leave UNSET when nothing
# proxies the app: trusting X-Forwarded-For with no proxy in front lets any caller
# spoof its own IP and defeat the rate limiter entirely.
# TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# PostgreSQL
#
# DATABASE_URL is the ONLY way the backend reaches Postgres. There is one
# connection pool, in src/config/db.js, and it reads this and nothing else.
#
# (Until Phase 4 there were seven pools, and one of them read a separate set of
# POSTGRES_HOST/PORT/DB/USER/PASSWORD variables. That pool is gone, those
# variables are no longer read by anything, and this template used to list them
# as REQUIRED — so anyone following it was setting five variables that did not
# matter. Delete them from any existing backend/.env.)
#
# Where to get this: your provider's dashboard (Supabase: Project Settings ->
# Database -> Connection string; Neon/Render: the connection details panel).
# For local development, `docker compose up -d` gives you exactly the URL below.
# -----------------------------------------------------------------------------

# REQUIRED — full Postgres connection string. Validated at boot: it must parse as
# a URL, use the postgres:// or postgresql:// scheme, and name a database.
DATABASE_URL=postgresql://easytrip:easytrip@localhost:5432/easytrip

# OPTIONAL — maximum connections in the pool. Defaults to 10 (pg's own default).
# Managed tiers often cap total connections around 60-100; keep the product of
# this and your instance count under that.
# PG_POOL_MAX=10

# OPTIONAL — how slow a request must be, in milliseconds, before it is logged at
# `warn` instead of `info`. Defaults to 1000.
#
# Every request already records its `responseTime`, so a slow one is findable by
# anyone who goes looking; this is what makes it arrive instead. Raise it if
# healthy traffic is tripping it — a threshold that fires on normal requests is
# one people learn to filter out, which is worse than not having it.
#
# A slow /api/health check is deliberately NOT demoted like a fast one: it is the
# earliest sign the database is struggling.
# SLOW_REQUEST_MS=1000

# -----------------------------------------------------------------------------
# Database TLS
#
# In production the connection verifies the server's certificate. Development
# uses no TLS at all, because a local Postgres over loopback has no certificate.
#
# Managed providers usually issue certificates from their own root, which Node
# does not trust by default. If the server fails to connect with "self-signed
# certificate in certificate chain", that is this — not a broken database.
# -----------------------------------------------------------------------------

# OPTIONAL, PREFERRED IN PRODUCTION — the provider's CA certificate, PEM
# contents. Keeps verification ON and lets the chain resolve. Wrap in double
# quotes with literal \n escapes, as with FIREBASE_PRIVATE_KEY below.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_ME\n-----END CERTIFICATE-----\n"

# OPTIONAL — escape hatch. Accepts ANY certificate, including an attacker's, so
# the connection is encrypted but the peer is unauthenticated. Prefer
# DATABASE_CA_CERT. Logs a warning on every boot, deliberately.
# DATABASE_SSL_NO_VERIFY=true

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-side token verification)
#
# Where to get these: Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". The downloaded JSON contains project_id,
# client_email and private_key. Do not commit that JSON file — it is gitignored.
# -----------------------------------------------------------------------------

# REQUIRED — Firebase project id ("project_id" in the service-account JSON).
FIREBASE_PROJECT_ID=your-firebase-project-id

# REQUIRED — service-account email ("client_email" in the service-account JSON).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com

# REQUIRED — service-account private key ("private_key" in the JSON).
# MUST be wrapped in double quotes and use literal \n escape sequences rather
# than real line breaks: src/config/firebase-admin.js expands them back with
# .replace(/\\n/g, '\n'). An unquoted or multi-line value will not parse.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# OPTIONAL — Cloud Storage bucket for the Admin SDK. Firebase console -> Storage.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# OPTIONAL — legacy fallback used only when FIREBASE_STORAGE_BUCKET is unset
# (src/config/firebase-admin.js). Prefer FIREBASE_STORAGE_BUCKET above.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# -----------------------------------------------------------------------------
# Cloudinary (image uploads)
#
# Where to get these: Cloudinary dashboard -> Product Environment Credentials.
# -----------------------------------------------------------------------------

# REQUIRED for uploads — Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# REQUIRED for uploads — Cloudinary API key.
CLOUDINARY_API_KEY=000000000000000

# REQUIRED for uploads — Cloudinary API secret. Treat as a password.
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# -----------------------------------------------------------------------------
# Optional — real road distances (FV-026 stage b)
# -----------------------------------------------------------------------------
#
# OPTIONAL. Free key from https://account.heigit.org — no card, no cost.
#
# Without it the app runs exactly as it does today: the feasibility engine
# estimates travel time from straight-line distance inflated by a road factor,
# and labels every such finding "estimated". With it, the same findings carry a
# measured road distance and stop carrying the caveat.
#
# Two obligations come with the key, both already implemented and tested:
#   - results are CC-BY 4.0, so attribution travels with every finding built
#     from them (HeiGIT for the service, OpenStreetMap for the data);
#   - rate limits are per endpoint and the Matrix figure is not published, so
#     the client reads `x-ratelimit-remaining` rather than assuming a quota.
#
# Treat as a password: it is a bearer credential in an Authorization header.
OPENROUTESERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Not required to run the server
# -----------------------------------------------------------------------------
#
# Nothing below this line is read by the backend any more. The only consumer was
# src/services/placeService.js, a stray copy of the frontend service that no
# backend module required; it has been deleted. NEXT_PUBLIC_API_URL belongs in
# frontend/.env.local — see frontend/.env.example.
