# Shared editor settings for both tiers (IMP-097).
# The repo is checked out on Windows and CI runs on Linux, so line endings are pinned rather than
# left to each developer's editor — otherwise every save rewrites files nobody edited.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
